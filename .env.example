# Copy this file's contents into your hosting platform's environment
# variables (Railway/Render/etc). Never commit real values to GitHub.

SECRET_KEY=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# These are only FIRST-RUN defaults. Once the app is running, change
# branding, price, colors, contact info etc from /admin/settings instead
# of editing environment variables again.
BUSINESS_NAME=Saif Matrimonial Services
BUSINESS_TAGLINE=Trusted Connections, Blessed Beginnings
BUSINESS_PHONE=7762023966
WHATSAPP_NUMBER=7762023966
BUSINESS_EMAIL=
BUSINESS_LOCATION=Kolkata, India
UNLOCK_PRICE=11
UPI_ID=yourupi@bank
PRIMARY_COLOR=#0b5a44
SECONDARY_COLOR=#073e2f
ACCENT_COLOR=#c9a86a

# Set to "true" once the site is served over HTTPS (Railway/Render always
# provide HTTPS, so set this to true in production).
SESSION_COOKIE_SECURE=true

# Optional: point persistent data (database + uploaded photos) at a
# mounted volume path instead of the project folder. REQUIRED if you
# want data to survive redeploys on Railway/Render.
# DATA_DIR=/data

# ---------------------------------------------------------------------
# OTP delivery for "My Requests" access. Default is "console", which
# just logs the OTP to the server log and shows it directly in a flash
# message on the site (fine for testing, NOT fine for real users since
# anyone could read the server log). For production, pick a real SMS
# provider and set its keys below.
# ---------------------------------------------------------------------
OTP_PROVIDER=console
# OTP_PROVIDER=fast2sms
# FAST2SMS_API_KEY=your-key-here
# OTP_PROVIDER=msg91
# MSG91_API_KEY=your-key-here
# MSG91_TEMPLATE_ID=your-otp-template-id

# ---------------------------------------------------------------------
# Admin alerts — fired the instant a customer submits payment proof.
# All optional and independent; enable whichever you have.
# ---------------------------------------------------------------------
# SMS to admin (reuses OTP_PROVIDER above — set FAST2SMS_API_KEY / MSG91_API_KEY too)
# ADMIN_NOTIFY_PHONE=9876543210

# Email to admin (via SMTP — Gmail example: use an "App Password", not your normal password)
# ADMIN_NOTIFY_EMAIL=owner@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=your-gmail@gmail.com

# WhatsApp — requires a WhatsApp Business API provider (e.g. Meta Cloud API,
# Twilio WhatsApp). WHATSAPP_API_URL is that provider's send-message endpoint,
# WHATSAPP_API_TOKEN its bearer token. Not enabled by default because it needs
# a business-verified account you set up separately — SMS/email above work
# immediately without one. Even without any of this configured, logged-in
# admins get a live badge + sound alert on every admin page (no setup needed).
# WHATSAPP_API_URL=https://your-provider.example.com/v1/messages
# WHATSAPP_API_TOKEN=your-provider-token
# WHATSAPP_ADMIN_NUMBER=919876543210

# ---------------------------------------------------------------------
# Agent Portal — agents are created by the admin (Admin > Agents), never
# via public self-signup. Login needs: phone number + OTP + the unique
# access code shown once when the agent is created. No extra env vars
# required to enable this; it's on by default.
# ---------------------------------------------------------------------
